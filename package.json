{
  "name": "sapphire-table",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "pnpm --filter=*core test",
    "build": "pnpm --filter=*core build && pnpm update \"@sapphire-table/*\" && pnpm --filter=./packages/sapphire-* build",
    "build:g": "pnpm -r build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "5.20.0",
    "@typescript-eslint/parser": "5.20.0",
    "eslint": "8.12.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "prettier": "3.3.2",
    "sass": "^1.79.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
